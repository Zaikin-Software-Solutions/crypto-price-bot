# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Target Telegram channel id (numeric, usually starts with -100...) or @channel_username
TELEGRAM_CHANNEL_ID=

# LiveCoinWatch API key. Get one at https://www.livecoinwatch.com/tools/api
LIVECOINWATCH_API_KEY=

# Optional: comma-separated list of LiveCoinWatch coin codes to track.
# Defaults to: BTC,ETH,TONCOIN,KAS,_GRAM
# Note: LiveCoinWatch uses TONCOIN (not TON) for the Telegram-Open-Network token.
# COINS=BTC,ETH,TONCOIN,KAS,_GRAM

# Optional: cron expression for the publish schedule. Defaults to every minute.
# PUBLISH_CRON=* * * * *

# Optional: HTTP request timeout in seconds. Defaults to 10.
# HTTP_TIMEOUT_SECONDS=10

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=INFO

# Optional: log format (json | console). Defaults to json.
# LOG_FORMAT=json
